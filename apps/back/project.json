{
  "name": "back",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/back/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/back",
        "main": "apps/back/src/main.ts",
        "tsConfig": "apps/back/tsconfig.app.json",
        "rootDir": "apps/back/src",
        "outputFileName": "main.js",
        "assets": [
          {
            "input": "apps/back/src/assets",
            "glob": "**/*",
            "output": "assets"
          }
        ]
      },
      "configurations": {
        "production": {
          "optimization": true
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "back:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "back:build:development"
        },
        "production": {
          "buildTarget": "back:build:production"
        }
      }
    }
  },
  "tags": []
}
