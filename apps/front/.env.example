# --- Frontend (Angular 16) ---
# Solo las variables con prefijo NG_APP_ se inyectan en el bundle.
# Docs: https://github.com/chihab/ngx-env

# Entorno: development | staging | production  (si se omite, usa NODE_ENV)
NG_APP_ENV=development

# URL base de la API (backend NestJS).
NG_APP_API_URL=http://localhost:3000/api
