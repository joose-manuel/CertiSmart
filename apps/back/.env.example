# --- Backend (NestJS) ---
# Copia este archivo a `.env` para desarrollo local.
# En Render estas variables se configuran en el dashboard (Environment).

# Entorno de ejecución: development | staging | production
NODE_ENV=development

# Puerto HTTP del servidor (Render lo inyecta automáticamente en producción).
PORT=3000

# Prefijo global de las rutas de la API.
API_PREFIX=api

# Orígenes permitidos para CORS (separados por coma) o "*" para todos.
CORS_ORIGINS=http://localhost:4200,https://certismart.vercel.app
